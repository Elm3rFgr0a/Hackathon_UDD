# Copia este archivo como .env (no se sube al repo).

# Secreto para firmar los tokens de sesión. Todo el equipo debe usar el mismo valor
# para que un deploy no invalide las sesiones de los demás.
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Perfil local de AWS para `npm run dev`. Sin esto, el modo local usa tu perfil
# `default`, que puede ser de otra cuenta. El deploy usa provider.profile.
AWS_PROFILE=hackaton

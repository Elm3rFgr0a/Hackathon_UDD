# Copia este archivo como .env (no se sube al repo).

# Secreto para firmar los tokens de sesión. Todo el equipo debe usar el mismo valor
# para que un deploy no invalide las sesiones de los demás.
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Perfil local de AWS para `npm run dev`. Sin esto, el modo local usa tu perfil
# `default`, que puede ser de otra cuenta. El deploy usa provider.profile.
AWS_PROFILE=hackaton

# WhatsApp con Twilio (opcional). Sin estas tres variables, las alertas se
# registran como "simuladas" y se ven igual en la app.
# Sandbox: https://console.twilio.com → Messaging → Try it out → WhatsApp.
# Cada teléfono que recibe debe unirse al sandbox enviando "join <palabra>".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Teléfono de la demo (+569...). Si está, todas las alertas van a ese número,
# porque los teléfonos del seed son ficticios.
WHATSAPP_DEMO_TO=
